PORT=24247
SESSION_SECRET=replace-with-at-least-32-random-characters

# Existing clones; absolute Windows paths are recommended.
SERVER_ROOT=C:\Users\YourName\Source\2009scape
# classic = fast merge behavior; mk2 = dependency analysis and compilation isolation.
DEPLOY_MODE=classic
CLASSIC_SERVERTOOLS_ROOT=C:\Users\YourName\Source\2009servertools-classic
MK2_SERVERTOOLS_ROOT=C:\Users\YourName\Source\2009servertools-mk2
PYTHON_COMMAND=python

# Emergency local login. Use a long, unique password.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Discord OAuth (optional until configured in the Discord Developer Portal).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:24247/auth/discord/callback
DISCORD_GUILD_ID=
# Comma-separated Discord role IDs. Any matching role grants access.
DISCORD_ADMIN_ROLE_IDS=
